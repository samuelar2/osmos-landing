---
import Page from "../layouts/Page.astro";
import { features } from "../data/features";
---

<Page title="Page not found · osmos assistant" description="This page doesn't exist. Head back to osmos assistant, the help centre or the FAQ." path="/404" noindex>
  <header class="page-hero">
    <p class="kicker">404</p>
    <h1>This page wandered off.</h1>
    <p class="lede">The link may be old or mistyped. Here's where most people are headed.</p>
  </header>

  <section class="band band--narrow" style="padding-top:0">
    <div class="cards cards--2">
      <div class="card">
        <h3>Start here</h3>
        <ul class="linklist">
          <li><a href="/">Home</a></li>
          <li><a href="/help">Help centre</a></li>
          <li><a href="/faq">FAQ</a></li>
        </ul>
      </div>
      <div class="card">
        <h3>What osmos does</h3>
        <ul class="linklist">
          {
            features.map((f) => (
              <li>
                <a href={`/${f.slug}`}>{f.h1.replace(/\.$/, "")}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Page>
