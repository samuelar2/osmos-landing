---
// Top navigation. The homepage keeps it minimal; inner pages add a few text links.
import { APP_STORE } from "../lib/site";

interface Props {
  links?: boolean;
}
const { links = false } = Astro.props;
---

<header class="nav" data-nav>
  <a href="/" class="nav__logo" aria-label="osmos home">
    <img src="/brand/osmos-wordmark-white.webp" alt="osmos" width="657" height="153" />
  </a>
  <div class="nav__right">
    {
      links && (
        <nav class="nav__links" aria-label="Site">
          <a href="/email">Features</a>
          <a href="/help">Help</a>
          <a href="/faq">FAQ</a>
        </nav>
      )
    }
    <a href={APP_STORE} class="nav__cta">
      <svg viewBox="0 0 384 512" width="13" height="13" fill="currentColor" aria-hidden="true"
        ><path
          d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.7-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"
        ></path></svg
      >
      Get the app
    </a>
  </div>
</header>
